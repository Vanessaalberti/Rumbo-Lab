/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-TUK/SrKxI23KT5eGHMJx/HI87Rt5Br9dZmbBvhbHDz4='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.supabase.co https://*.supabase.in; connect-src 'self' https://*.supabase.co https://*.supabase.in; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; frame-src 'none'; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
